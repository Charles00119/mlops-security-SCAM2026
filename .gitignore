# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Secrets — never commit tokens
.env
*token*
*.key

# LaTeX build artifacts
*.aux
*.log
*.bbl
*.blg
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# OS / editor
.DS_Store
.idea/
.vscode/

# Large transient clone dirs (LOC counting clones into temp; never commit)
clones_tmp/

# Corpus-scan intermediates (keep only the merged scan_log.csv / verified.csv per pass)
scans/*/log[0-9]*.csv
scans/*/verified[0-9]*.csv
scans/*/shard*.txt
scans/*/worker*.out

# Patch files exchanged during review; never part of the package
*.patch
